\@writefile{toc}{\contentsline {subsection}{\numberline {4.5.3}Feature Correlation Structure}{118}{subsection.4.5.3}\protected@file@percent }
\newlabel{subsec:feature_correlation}{{4.5.3}{118}{Feature Correlation Structure}{subsection.4.5.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.15}{\ignorespaces Mean pairwise Spearman correlation among 10 features across 11 pathogens. Three clusters are evident: frequency-derived features (freq, entropy, rare variant, dN/dS proxy) are highly correlated ($\rho > 0.54$); deep learning features (ESM-2 LLR, semantic change) show weak negative correlation ($\rho = -0.09$); and structure-based features (pLDDT, SASA) are weakly anti-correlated ($\rho = -0.19$). Homoplasy is the most independent feature ($|\rho | < 0.23$ with all others).\relax }}{118}{figure.caption.75}\protected@file@percent }
\newlabel{fig:feature_correlation}{{4.15}{118}{Mean pairwise Spearman correlation among 10 features across 11 pathogens. Three clusters are evident: frequency-derived features (freq, entropy, rare variant, dN/dS proxy) are highly correlated ($\rho > 0.54$); deep learning features (ESM-2 LLR, semantic change) show weak negative correlation ($\rho = -0.09$); and structure-based features (pLDDT, SASA) are weakly anti-correlated ($\rho = -0.19$). Homoplasy is the most independent feature ($|\rho | < 0.23$ with all others).\relax }{figure.caption.75}{}}
