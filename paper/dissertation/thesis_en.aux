\@writefile{lof}{\contentsline {figure}{\numberline {4.15}{\ignorespaces Mean pairwise Spearman correlation among 10 features across 9 pathogens. Three clusters are evident: frequency-derived features (freq, entropy, rare variant, dN/dS proxy) are highly correlated ($\rho > 0.54$); deep learning features (ESM-2 LLR, semantic change) show weak negative correlation ($\rho = -0.09$); and structure-based features (pLDDT, SASA) are weakly anti-correlated ($\rho = -0.19$). Homoplasy is the most independent feature ($|\rho | < 0.23$ with all others).\relax }}{97}{figure.caption.77}\protected@file@percent }
\newlabel{fig:feature_correlation}{{4.15}{97}{Mean pairwise Spearman correlation among 10 features across 9 pathogens. Three clusters are evident: frequency-derived features (freq, entropy, rare variant, dN/dS proxy) are highly correlated ($\rho > 0.54$); deep learning features (ESM-2 LLR, semantic change) show weak negative correlation ($\rho = -0.09$); and structure-based features (pLDDT, SASA) are weakly anti-correlated ($\rho = -0.19$). Homoplasy is the most independent feature ($|\rho | < 0.23$ with all others).\relax }{figure.caption.77}{}}
