\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.1}{\ignorespaces Research overview. The study proceeds from problem identification through framework construction (MutBench with three core components), statistical validation establishing cross-pathogen heterogeneity, to multi-source information integration analysis.\relax }}{7}{figure.caption.9}%
\addvspace {10\p@ }
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces 3-Layer Ground Truth Framework. Layer\nobreakspace {}A (convergent evolution) defines true positives for MCC computation, Layer\nobreakspace {}B (purifying selection) defines true negatives for constrained FPR, and Layer\nobreakspace {}C (DMS fitness) provides independent experimental validation. The three layers capture orthogonal dimensions of mutational importance.\relax }}{27}{figure.caption.12}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Overview of the MutBench benchmark framework pipeline. Input multiple sequence alignment (MSA) data are processed through scoring formulas and detection methods, evaluated against a 3-layer ground truth, and analyzed using multiple statistical tests.\relax }}{34}{figure.caption.17}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Genome-wide hotspot map of the SARS-CoV-2 Spike protein. The seven annotated functional regions used as ground truth (RBD, NTD antigenic supersite, furin cleavage site, S2' cleavage site, fusion peptide, HR1, HR2) are mapped to nucleotide coordinates, encompassing 1,251 unique Spike nucleotide positions.\relax }}{37}{figure.caption.20}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Detection performance across multiple biological ground truths (Part 1). (A)\nobreakspace {}Best F1 by approach and ground truth, (B)\nobreakspace {}Enrichment ratio heatmap.\relax }}{58}{figure.caption.39}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Detection performance across multiple biological ground truths (Part 2). (C)\nobreakspace {}Ground truth overlap matrix (Jaccard similarity; diagonal shows set sizes), (D)\nobreakspace {}TC-freq-v3 score distributions for convergent vs non-convergent positions.\relax }}{58}{figure.caption.40}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces DMS-based ground truth evaluation (Part 1). (A)\nobreakspace {}F1 comparison between DMS-escape and functional-region ground truths, (B)\nobreakspace {}Cohen's d effect size for score separation across ground truths.\relax }}{59}{figure.caption.41}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces DMS-based ground truth evaluation (Part 2). (C)\nobreakspace {}Scatter plot of approach scores vs DMS functional importance, (D)\nobreakspace {}Precision-recall curves for DMS-escape (top 20\%) ground truth.\relax }}{59}{figure.caption.42}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Sample size convergence of hotspot metrics. Stable detection performance (Hotspot-score $\approx $ 0.62) is achieved starting at approximately 1,000 sequences.\relax }}{66}{figure.caption.48}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces MutClust parameter sensitivity heatmap. Full-factorial grid search over 64 parameter combinations ($\gamma \times d \times $ MinPts) shows that F1 performance is most sensitive to $\gamma $ (epsilon scaling factor), followed by $d$ (decay factor), with minimal influence of MinPts.\relax }}{66}{figure.caption.50}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Cross-pathogen comparison of detection method rankings between SARS-CoV-2 and H3N2. Method rankings differ substantially across pathogens, motivating pathogen-adaptive selection.\relax }}{71}{figure.caption.57}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Scoring--pathogen performance heatmap across 11 pathogens. Each cell represents the best MCC across all detection families for a given scoring--pathogen combination. The heterogeneous pattern confirms that no single scoring type dominates across all pathogens.\relax }}{77}{figure.caption.64}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces Mean MCC by scoring category across 11 pathogens. Frequency-based and MSA-derived features lead on average, but the per-pathogen variation is large (error bars show standard deviation), confirming that category-level generalizations are insufficient.\relax }}{78}{figure.caption.65}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces FUBAR phylogenetic scoring performance compared to the overall best scoring per pathogen. FUBAR Bayes factor achieves the highest MCC for H3N2 (0.534, marked with \textbf {$\star $}), demonstrating that phylogenetic positive selection signals can outperform all other information types for specific pathogens.\relax }}{79}{figure.caption.66}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces Variance decomposition of hotspot detection performance. The scoring $\times $ pathogen interaction ($\omega ^2 = 0.296$) is the largest source of variance, exceeding all main effects and other interactions by a wide margin.\relax }}{81}{figure.caption.68}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces LOPO cross-validation results. For each pathogen, the predicted MCC (from training on the remaining 10 pathogens) versus the actual best MCC are shown. The 0/11 match rate and large gaps confirm that cross-pathogen generalization fails completely.\relax }}{82}{figure.caption.69}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces Per-feature AUC heatmap for Layer\nobreakspace {}A prediction. Green indicates high discriminative power; red indicates inverse association (AUC $< 0.5$). The best feature per pathogen is shown in bold. No single feature achieves the highest AUC for more than 3 of 9 pathogens.\relax }}{93}{figure.caption.75}%
\contentsline {figure}{\numberline {4.14}{\ignorespaces Random Forest feature importance for Layer\nobreakspace {}A prediction across 9 pathogens (10 features). Bar colors indicate feature category: blue (frequency-based), green (phylogeny/evolutionary), purple (deep learning), orange (structure), crimson (chemical property). Cross-validation AUC is shown in each panel title. The dominant feature differs across pathogens: ESM-2 LLR for SARS-CoV-2, pLDDT for H3N2, homoplasy for Norovirus, dN/dS proxy for HCV.\relax }}{96}{figure.caption.76}%
\contentsline {figure}{\numberline {4.15}{\ignorespaces Mean pairwise Spearman correlation among 10 features across 9 pathogens. Three clusters are evident: frequency-derived features (freq, entropy, rare variant, dN/dS proxy) are highly correlated ($\rho > 0.54$); deep learning features (ESM-2 LLR, semantic change) show weak negative correlation ($\rho = -0.09$); and structure-based features (pLDDT, SASA) are weakly anti-correlated ($\rho = -0.19$). Homoplasy is the most independent feature ($|\rho | < 0.23$ with all others).\relax }}{97}{figure.caption.77}%
\contentsline {figure}{\numberline {4.16}{\ignorespaces Feature ablation analysis: change in mean MCC (12 pathogens) when removing each feature from the 10-feature EqualWeight ensemble. Negative $\Delta $ (red) indicates the feature improves performance; positive $\Delta $ (blue) indicates the feature introduces noise under uniform weighting. Homoplasy is the single most important feature ($\Delta = -0.028$).\relax }}{100}{figure.caption.78}%
