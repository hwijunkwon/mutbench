\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.1}{\ignorespaces Research overview. The study proceeds from problem identification through framework construction (MutBench with three core components), statistical validation establishing cross-pathogen heterogeneity, to the PAHD proof-of-concept prototype.\relax }}{5}{figure.caption.8}%
\addvspace {10\p@ }
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces 3-Layer Ground Truth Framework. Layer\nobreakspace {}A (convergent evolution) defines true positives for MCC computation, Layer\nobreakspace {}B (purifying selection) defines true negatives for constrained FPR, and Layer\nobreakspace {}C (DMS fitness) provides independent experimental validation. The three layers capture orthogonal dimensions of mutational importance.\relax }}{21}{figure.caption.11}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Overview of the MutBench benchmark framework pipeline. Input multiple sequence alignment (MSA) data are processed through scoring formulas and detection methods, evaluated against a 3-layer ground truth, and analyzed using multiple statistical tests.\relax }}{25}{figure.caption.16}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Genome-wide hotspot map of the SARS-CoV-2 Spike protein. The seven annotated functional regions used as ground truth (RBD, NTD antigenic supersite, furin cleavage site, S2' cleavage site, fusion peptide, HR1, HR2) are mapped to nucleotide coordinates, encompassing 1,251 unique Spike nucleotide positions.\relax }}{28}{figure.caption.19}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Method comparison on synthetic SARS-CoV-2 data (Part 1). (A)\nobreakspace {}Performance metrics at top-10\% threshold, (B)\nobreakspace {}Best F1 scores at optimal threshold, (C)\nobreakspace {}CH-score distribution for functional vs non-functional positions.\relax }}{51}{figure.caption.37}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Method comparison on synthetic SARS-CoV-2 data (Part 2). (D)\nobreakspace {}Score profiles along the Spike protein, (E)\nobreakspace {}H-score saturation problem, (F)\nobreakspace {}Functional region enrichment in the top-10\% of scored positions.\relax }}{51}{figure.caption.38}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Detection performance across multiple biological ground truths (Part 1). (A)\nobreakspace {}Best F1 by approach and ground truth, (B)\nobreakspace {}Enrichment ratio heatmap.\relax }}{54}{figure.caption.40}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Detection performance across multiple biological ground truths (Part 2). (C)\nobreakspace {}Ground truth overlap matrix (Jaccard similarity; diagonal shows set sizes), (D)\nobreakspace {}TC-freq-v3 score distributions for convergent vs non-convergent positions.\relax }}{55}{figure.caption.41}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces DMS-based ground truth evaluation (Part 1). (A)\nobreakspace {}F1 comparison between DMS-escape and functional-region ground truths, (B)\nobreakspace {}Cohen's d effect size for score separation across ground truths.\relax }}{55}{figure.caption.42}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces DMS-based ground truth evaluation (Part 2). (C)\nobreakspace {}Scatter plot of approach scores vs DMS functional importance, (D)\nobreakspace {}Precision-recall curves for DMS-escape (top 20\%) ground truth.\relax }}{56}{figure.caption.43}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Sample size convergence of hotspot metrics. Stable detection performance (Hotspot-score $\approx $ 0.62) is achieved starting at approximately 1,000 sequences.\relax }}{66}{figure.caption.49}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces MutClust parameter sensitivity heatmap. Full-factorial grid search over 64 parameter combinations ($\gamma \times d \times $ MinPts) shows that F1 performance is most sensitive to $\gamma $ (epsilon scaling factor), followed by $d$ (decay factor), with minimal influence of MinPts.\relax }}{66}{figure.caption.51}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces Cross-pathogen comparison of detection method rankings between SARS-CoV-2 and H3N2. Method rankings differ substantially across pathogens, motivating pathogen-adaptive selection.\relax }}{74}{figure.caption.58}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces Scoring--detection performance heatmap across 9 pathogens. Each cell represents mean MCC for a scoring--detection family combination. The heterogeneous pattern confirms that no single combination dominates across all pathogens. Detailed MCC values for all scoring--detection combinations are available in Table\nobreakspace {}\ref {tab:9pathogen_best}; the heatmap provides a visual overview of performance patterns.\relax }}{82}{figure.caption.65}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces Variance decomposition of hotspot detection performance. The detection family $\times $ pathogen interaction ($\omega ^2 = 0.285$) is the largest source of variance, exceeding all main effects.\relax }}{84}{figure.caption.67}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Region-overlap MCC under three evaluation modes (Exact, $\pm $5, $\pm $10 windows) for each pathogen. The consistent improvement from exact to $\pm $10 window evaluation demonstrates that detected hotspots are spatially proximate to ground truth positions across all 9 pathogens.\relax }}{108}{figure.caption.74}%
